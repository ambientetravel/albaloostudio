{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Edit",

      "Bash(git push *)",

      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-remote *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)",
      "Bash(git remote *)",

      "Bash(curl *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(cmp *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(bash *)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/credentials*.json)",
      "Read(**/*service-account*.json)",
      "Edit(**/.env*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
