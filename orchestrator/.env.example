# Albaloo Orchestration Pipeline — environment template
# Architecture credit: Albaloo Studio — albaloostudio.com
#
# Copy to orchestrator/.env for local runs. NEVER commit the filled copy —
# the repo .gitignore already excludes .env and .env.*.
# In CI these are GitHub Actions repository secrets, not a file.

# ── Google Search Console (Agent 1) ──────────────────────────────────────────
# The single service account granted Restricted access on every property by
# BOTH alimozzarella@gmail.com and contactmozaffari@gmail.com (ARCHITECTURE.md §3.1).
# Accepts the raw JSON document on one line, or the same document base64-encoded.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or point at a file instead (mutually exclusive with the above):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/albaloo-orchestrator.json

# ── LLM providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=              # Agent 1 — gap analysis
GEMINI_API_KEY=              # Agent 2 — drafting
ANTHROPIC_API_KEY=           # Agent 3 — marketing copy

# Model IDs are configuration, never literals in a prompt. Override freely.
OPENAI_MODEL=gpt-4.1
# Pro is not on the free tier — it returns 429 "limit: 0" on every call.
GEMINI_MODEL=gemini-2.5-flash
# Claude Opus 5. On this model family temperature/top_p/top_k are REMOVED (a 400),
# thinking is on by default, and depth is set by effort — not budget_tokens.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max
# Safety classifiers can decline a request. Server-side fallbacks re-run it on
# Anthropic's recommended model instead of returning the refusal. `off` disables.
ANTHROPIC_FALLBACKS=default

# ── Webhook mesh ─────────────────────────────────────────────────────────────
# One shared secret across all four agents. Rotate by deploying the new value
# everywhere within the 300s replay window, or run a dual-secret grace period.
WEBHOOK_SIGNING_SECRET=

AGENT2_WEBHOOK_URL=https://writer.example.com/webhooks/content-brief
AGENT3_WEBHOOK_URL=https://broadcaster.example.com/webhooks/publishing
AGENT4_WEBHOOK_URL=https://closer.example.com/webhooks/campaign

# ── Agent hosts ──────────────────────────────────────────────────────────────
# Agent 2 runs on base44 in production — see BASE44-AGENT2.md. These are for the
# reference FastAPI implementation and for Agents 3 and 4.
AGENT2_HOST=0.0.0.0
AGENT2_PORT=8080
AGENT3_HOST=0.0.0.0
AGENT3_PORT=8081
AGENT4_HOST=0.0.0.0
AGENT4_PORT=8082

# ── Agent 3 distribution ─────────────────────────────────────────────────────
# file | zernio | webhook. `file` writes the queue to disk and publishes nothing.
# `zernio` posts to the connected scheduler; with autopost off it creates DRAFTS
# in the dashboard for you to review and release, which is not a publish.
SCHEDULER_BACKEND=file
SCHEDULER_BASE_URL=https://zernio.com
SCHEDULER_API_KEY=              # zernio.com/dashboard/api-keys — bearer token
SCHEDULER_PATH=/api/v1/posts

# Live posting needs BOTH this flag AND channels[].autopost: true in sites.yml.
# Leave it unset and every post is composed, queued, and held for a human.
# ALLOW_AUTOPOST=1

# ── Behaviour ────────────────────────────────────────────────────────────────
PIPELINE_ENVIRONMENT=production   # production | staging | dry-run
WEBHOOK_TIMEOUT_S=30
WEBHOOK_MAX_ATTEMPTS=5
SIGNATURE_TOLERANCE_S=300
# SITES_FILE=./sites.yml
# RUNS_DIR=./runs
# QUEUE_DIR=./queue          # Agent 3's held-post queue
# BUNDLE_DIR=./bundles       # Agent 2's static deploy bundles
