{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://albaloostudio.com/schemas/content.brief.v1.json",
  "title": "content.brief.v1",
  "description": "Agent 1 (SEO Scout) -> Agent 2 (Writer). Architecture credit: Albaloo Studio.",
  "type": "object",
  "required": ["schema_version", "envelope", "site", "opportunity", "brief", "compliance", "routing"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "envelope": { "$ref": "#/$defs/envelope" },

    "site": {
      "type": "object",
      "required": ["domain", "brand", "locale", "base_url", "cms"],
      "properties": {
        "domain": { "type": "string", "format": "hostname" },
        "property_uri": { "type": "string" },
        "brand": { "type": "string" },
        "locale": { "type": "string", "description": "BCP-47, e.g. fa-IR" },
        "market": { "type": "string" },
        "base_url": { "type": "string", "format": "uri" },
        "cms": {
          "type": "object",
          "required": ["type", "publish_mode"],
          "properties": {
            "type": { "enum": ["wordpress", "astro", "base44", "static", "unknown"] },
            "adapter": { "type": ["string", "null"] },
            "content_root": { "type": "string" },
            "publish_mode": { "enum": ["draft", "scheduled", "publish"] }
          }
        }
      }
    },

    "opportunity": {
      "type": "object",
      "required": ["gap_type", "primary_keyword", "search_intent", "gsc", "priority_score", "rationale"],
      "properties": {
        "gap_type": {
          "enum": ["missing_page", "thin_content", "cannibalisation", "stale_content",
                   "serp_feature_loss", "competitor_outranking", "untranslated"]
        },
        "primary_keyword": { "type": "string", "minLength": 1 },
        "keyword_locale": { "type": "string" },
        "secondary_keywords": { "type": "array", "items": { "type": "string" } },
        "search_intent": { "enum": ["informational", "commercial", "transactional", "navigational"] },
        "gsc": {
          "type": "object",
          "required": ["date_range", "impressions", "clicks", "ctr", "avg_position"],
          "properties": {
            "date_range": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "string", "format": "date" },
                "end": { "type": "string", "format": "date" }
              }
            },
            "impressions": { "type": "integer", "minimum": 0 },
            "clicks": { "type": "integer", "minimum": 0 },
            "ctr": { "type": "number", "minimum": 0, "maximum": 1 },
            "avg_position": { "type": "number", "minimum": 1 },
            "best_position": { "type": "number", "minimum": 1 },
            "trend_28d": { "enum": ["rising", "flat", "falling"] },
            "top_country": {
              "type": ["string", "null"],
              "description": "ISO-3166-1 alpha-3, lowercase, as GSC returns it"
            },
            "current_url": { "type": ["string", "null"], "format": "uri" },
            "device_split": {
              "type": "object",
              "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "serp": {
          "type": "object",
          "properties": {
            "checked_at": { "type": "string", "format": "date-time" },
            "competitors": { "type": "array", "items": { "type": "object" } },
            "features": { "type": "array", "items": { "type": "string" } },
            "source": { "enum": ["gsc_inference", "serp_api", "manual"] }
          }
        },
        "priority_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "priority_inputs": {
          "type": "object",
          "properties": {
            "volume": { "type": "number" },
            "position_proximity": { "type": "number" },
            "commercial_value": { "type": "number" },
            "effort": { "type": "number" }
          }
        },
        "rationale": { "type": "string" }
      }
    },

    "brief": {
      "type": "object",
      "required": ["working_title", "content_type", "target_url_path", "language",
                   "word_count_target", "outline", "must_avoid", "meta"],
      "properties": {
        "working_title": { "type": "string", "minLength": 1 },
        "content_type": {
          "enum": ["guide", "landing", "itinerary", "comparison", "faq", "news", "translation"]
        },
        "target_url_path": { "type": "string", "pattern": "^/" },
        "language": { "type": "string" },
        "word_count_target": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 100 },
            "max": { "type": "integer", "minimum": 100 }
          }
        },
        "reading_level": { "type": "string" },
        "tone": { "type": "string" },
        "outline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["h", "heading"],
            "properties": {
              "h": { "type": "integer", "minimum": 2, "maximum": 3 },
              "heading": { "type": "string" },
              "must_cover": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "must_include": { "type": "array", "items": { "type": "string" } },
        "must_avoid": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Always contains the Persian Gulf and visa blockers (ARCHITECTURE.md 7.1/7.2)"
        },
        "internal_links": { "type": "array", "items": { "type": "object" } },
        "external_sources": { "type": "array", "items": { "type": "object" } },
        "schema_org": { "type": "array", "items": { "type": "string" } },
        "meta": {
          "type": "object",
          "required": ["title", "description"],
          "properties": {
            "title": { "type": "string", "maxLength": 70 },
            "description": { "type": "string", "maxLength": 200 },
            "og_image_hint": { "type": ["string", "null"] }
          }
        },
        "media": {
          "type": "object",
          "properties": {
            "hero_required": { "type": "boolean" },
            "allowed_sources": { "type": "array", "items": { "type": "string" } },
            "credit_required": { "type": "boolean" }
          }
        },
        "data_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "source"],
            "properties": {
              "field": { "type": "string" },
              "source": { "type": "string", "format": "uri" },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },

    "compliance": { "$ref": "#/$defs/compliance_directive" },

    "routing": {
      "type": "object",
      "properties": {
        "callback_url": { "type": ["string", "null"], "format": "uri" },
        "priority": { "enum": ["high", "normal", "low"] },
        "deadline": { "type": ["string", "null"], "format": "date-time" },
        "dry_run": { "type": "boolean" }
      }
    }
  },

  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["message_id", "correlation_id", "idempotency_key", "message_type",
                   "emitted_at", "emitted_by", "target", "architecture_credit"],
      "properties": {
        "message_id": { "type": "string" },
        "correlation_id": { "type": "string" },
        "causation_id": { "type": ["string", "null"] },
        "idempotency_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "message_type": { "const": "content.brief" },
        "emitted_at": { "type": "string", "format": "date-time" },
        "emitted_by": { "type": "string" },
        "target": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "environment": { "enum": ["production", "staging", "dry-run"] },
        "architecture_credit": {
          "const": "Albaloo Studio",
          "description": "Mandatory. A payload missing this field is rejected 400."
        },
        "owner": { "type": ["string", "null"] }
      }
    },
    "compliance_directive": {
      "type": "object",
      "required": ["profile", "persian_gulf_only", "visa_accuracy", "no_invented_facts", "blocking"],
      "properties": {
        "profile": { "type": "string" },
        "persian_gulf_only": { "const": true },
        "visa_accuracy": { "const": true },
        "no_invented_facts": { "const": true },
        "brand_neutral_embed": { "type": "boolean" },
        "sanctions_check": { "type": "boolean" },
        "blocking": { "type": "boolean" },
        "preflight": { "type": "object" }
      }
    }
  }
}
