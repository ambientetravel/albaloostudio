# ── secrets / credentials ─────────────────────────────────────────────────
# res-portal/inc/config.php holds ADMIN_BOOT_USER + ADMIN_BOOT_PASS in plain
# text. Keep the whole portal out of git until those move to a local-only
# config; see inc/config.local.php.example.
res-portal/inc/config.php
res-portal/inc/config.local.php
res-portal/data/
**/config.local.php
*.key
*.pem
.env
.env.*
# …but the TEMPLATE must be committed: it documents every secret the pipeline
# needs and the setup docs link to it. It contains no values.
!.env.example
!**/.env.example

# ── captured leads / customer data (PII — never commit) ───────────────────
_local-leads.jsonl
**/leads.json
**/leads.json.php
**/data/*.json.php

# ── separate repositories (their own git remotes) ────────────────────────
# exploreorient is now its own repo: github.com/ambientetravel/exploreorient
exploreorient/

# ── dependencies & build output ──────────────────────────────────────────
node_modules/
package-lock.json
dist/
.astro/

# ── deploy artefacts ─────────────────────────────────────────────────────
*.zip
boutimar-*.zip

# ── OS / editor cruft ────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
*~

# ── worktrees / scratch ──────────────────────────────────────────────────
.claude/worktrees/

# local-only test fixture: a JSON copy of the live feed so journey.html
# can be exercised against the static dev server. The real api/ is PHP on the host.
boutimar-ir/api/

# local-only widget test fixture (not for deploy)
boutimar-partner/deploy-boutimar-ir/embed/cruises/_testfeed.json

# widget local test fixture (not deployed — production reads boutimar.ir/data/)
boutimar-partner/deploy-boutimar-ir/embed/cruises/data/

# ── orchestrator run artefacts (briefs, manifests, dead letters) ─────────
orchestrator/runs/
orchestrator/__pycache__/
orchestrator/queue/
orchestrator/bundles/

orchestrator/reports/

# Agent run output — manifests, briefs and dead-letters are per-run artifacts.
orchestrator/runs/
orchestrator/bundles/

# Staged deploy tree for albaloostudio.com — built by scripts/stage-site.py
_site/

# Python bytecode from running the orchestrator locally
__pycache__/
*.pyc

# Agent 3 scheduler file-backend queue and Agent 3 batch output
orchestrator/queue/
orchestrator/broadcast/
orchestrator/written/*
# except the briefed-keyword ledger, which is state the pipeline must keep
# across CI runs so Agent 1 stops re-proposing keywords it already briefed.
!orchestrator/written/briefed-ledger.json

# Agent 4 batch output — holds redacted customer messages
orchestrator/closed/

# ── cruise24.me / AmbiMare media ─────────────────────────────────────────
# Fetched by cruise24-me/download_media.py from the lines' CDNs. Videos are
# tens of MB each and belong on the web host, not in git; index.json is
# committed so the page's resolver map is reviewable.
cruise24-me/media/*
!cruise24-me/media/.gitkeep
!cruise24-me/media/index.json
# web-sized photos (optimize_media.py) are committed; videos are not
!cruise24-me/media/*.jpg
!cruise24-me/media/*.jpeg
!cruise24-me/media/*.webp
!cruise24-me/media/variety/
!cruise24-me/media/cruisehost/
!cruise24-me/media/lines/
# print-sized masters from the CDN, kept locally so optimize_media.py can re-run
cruise24-me/media-originals/

# cruise24.me build output: regenerated by build_journeys.py (≈2 s) before every deploy.
# 1,700+ pages that change with every price sync do not belong in history.
cruise24-me/journeys/
cruise24-me/data/sailings.json
cruise24-me/data/journeys-index.json
