# cruise24.me, Apache (GoDaddy cPanel hosting).
# staging.cruise24.me shares this document root for testing before the domain moves
# off Website Builder. Search engines must never index it.
<IfModule mod_headers.c>
  <If "%{HTTP_HOST} =~ /^staging\./">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# Live domain: one address, https://cruise24.me/. staging.* is left alone.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(www\.)?cruise24\.me$ [NC]
  RewriteRule ^ https://cruise24.me%{REQUEST_URI} [R=301,L]
</IfModule>
